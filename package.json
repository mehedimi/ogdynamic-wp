{
  "name": "ogdynamic",
  "private": true,
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehedimi/ogdynamic-wp.git"
  },
  "packageManager": "pnpm@11.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && vite build --config vite.block.config.ts",
    "build:block": "vite build --config vite.block.config.ts",
    "dev:block": "vite build --watch --config vite.block.config.ts",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "axios": "^1.16.0",
    "reka-ui": "^2.9.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.7",
    "vue": "^3.5.0",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/block-editor": "^20.0.0",
    "@wordpress/blocks": "^17.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/i18n": "^7.1.0"
  }
}
